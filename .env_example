# 模型配置
MODEL_NAME=qwen-flash
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
API_KEY=sk-xxxxx
EMBEDDING_MODEL_NAME=text-embedding-v3
VISION_MODEL_NAME=qwen-vl-plus

# 应用配置
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
STREAMLIT_HOST=127.0.0.1
STREAMLIT_PORT=8501
DATA_DIR=.\data\raw_data
SQLITE_PATH=.\data\metadata.db
FAISS_INDEX_DIR=.\data\faiss
RELATION_FAISS_INDEX_DIR=.\data\relation_faiss
NEO4J_URI= bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=xxx
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# Token 费用估算（DashScope 参考定价，可按实际套餐覆盖）
PRICE_PER_1K_PROMPT=0.04
PRICE_PER_1K_COMPLETION=0.12

# 多模态 / 实体抽取 / 引用提取 / 章节识别
ENABLE_MODAL_EXTRACTION=true
MODAL_MAX_IMAGES=20
MODAL_MAX_TABLES=20
ENABLE_ENTITY_EXTRACTION=false
ENTITY_EXTRACTION_MAX_CHUNKS=20
ENABLE_CITATION_EXTRACTION=false
ENABLE_SECTION_RECOGNITION=false
ENABLE_SECTION_CHUNKING=true

# 文本切块参数
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
SECTION_CHUNK_OVERLAP=50

# 混合检索参数
RRF_K=60
RETRIEVAL_FILTER_EXPAND=3
HYBRID_SEMANTIC_TOP_K=10
HYBRID_BM25_TOP_K=10

# Agent 行为参数
MASTER_AGENT_MAX_ITERATIONS=10
AGENT_MAX_HISTORY_TURNS=5

# 并发入库
INGESTION_MAX_WORKERS=4

# Reranker（可选，需要外部服务）
RERANKER_ENABLED=false
RERANKER_API_URL=
RERANKER_API_KEY=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=5
RERANKER_TIMEOUT=10
RERANKER_MAX_CANDIDATES=50

# ToolCall 限流
TOOL_CALL_MAX_PER_WINDOW=5
TOOL_CALL_WINDOW_SECONDS=60.0
